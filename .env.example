# ---------------------------------------------------------------------------
# IS THIS ART? — environment
# Copy to .env.local. The app runs fully with zero configuration using a local
# SQLite database. Values below are optional unless noted.
# ---------------------------------------------------------------------------

# Secret used to sign sessions, guest IDs and OAuth state.
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# Public origin, used for OAuth redirects, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed admin credentials (used only on first database creation).
SEED_ADMIN_EMAIL=admin@isart.local
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_USERNAME=curator

# Optional: Google OAuth. Button stays hidden until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Supabase Storage for uploaded artwork (falls back to local disk).
# The app's relational data stays in local SQLite; see README for the
# production Supabase migration in supabase/migrations/0001_init.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=artworks

# Optional: override the SQLite directory (defaults to ./data).
# DATA_DIR=./data
